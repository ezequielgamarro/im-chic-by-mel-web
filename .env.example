# Supabase — Panel de Administración (spec 007)
# Copia este archivo como `.env` y completa con los valores reales de tu proyecto.
# Encuéntralos en: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# (Opcional) Webhook para notificación de turnos al dueño (Make/Zapier/n8n/Slack/Discord).
# Si no se define, la alerta igual aparece en el panel admin → pestaña "Turnos".
VITE_OWNER_WEBHOOK_URL=
